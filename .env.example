# Nufo works with zero keys. Everything below is optional.

# USDA FoodData Central — free key: https://fdc.nal.usda.gov/api-key-signup
# Without it both apps use the public DEMO_KEY (fine for testing, rate-limited).
#   Android: put the line in android/local.properties (or export it) — read by app/build.gradle.kts
#   iOS:     set the USDA_API_KEY build setting (project.yml or an .xcconfig)
USDA_API_KEY=

# Open Food Facts needs no key; both apps send the required User-Agent "Nufo/1.0 (contact@nufo.app)".